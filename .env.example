# Discord Developer Portal 取得的 Bot Token。請勿提交真實 Token。
DISCORD_TOKEN=
# 同步仍採全域指令；填入 Guild ID 可清除該伺服器的舊版專用指令，避免重複。
DISCORD_GUILD_ID=0

# 本機 Ollama 設定
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=300

# !ask 輸入與輸出的最大字元數
MAX_ASK_INPUT_LENGTH=500
MAX_ASK_OUTPUT_LENGTH=1900

# 自然語言專案入口的唯一 Discord 頻道 ID；0 表示關閉，填入純數字後重啟 Bot。
PROJECT_INTAKE_CHANNEL_ID=0

# Day 26：管理員手動建立四頻道；上方入口對應 #project-requests。
# 0 或不可用時會議／狀態回到原頻道；dev-log 只記終端機。
AGENT_MEETING_CHANNEL_ID=0
PROJECT_STATUS_CHANNEL_ID=0
DEV_LOG_CHANNEL_ID=0

# 下列三個檔案設定供舊版 JSON Repository／手動測試；正式 Bot 使用 MySQL。
PROJECTS_FILE=projects.json

# 舊版 Guild 專案資料檔
GUILD_PROJECTS_FILE=guild_projects.json

# 舊版會議資料檔；下方長度預算仍用於正式 Bot（單位：字元）
MEETINGS_FILE=meetings.json
MAX_MEETING_MESSAGE_LENGTH=1900
MAX_MEETING_PROMPT_LENGTH=6000
MAX_MEETING_RESPONSE_LENGTH=4000
MEETING_AGENT_MAX_ATTEMPTS=2
MEETING_RETRY_DELAY_SECONDS=1.0

# MySQL 設定（請填入本機或 Docker 的帳密；不可提交 .env）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ai_company
DB_USER=ai_company_app
# 必填：自行設定兩個不同的強密碼。Docker 首次建庫後，改 .env 不會自動改資料庫密碼。
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=10

# 可使用 DEBUG、INFO、WARNING、ERROR
LOG_LEVEL=INFO

# Day 27：資料庫等待期限（秒）
DB_ACQUIRE_TIMEOUT_SECONDS=10
DB_OPERATION_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300
